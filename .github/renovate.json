{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "prek hook revs in prek.toml, pinned by commit SHA with a `# frozen: <tag>` comment",
      "managerFilePatterns": ["/^prek\\.toml$/"],
      "matchStrings": [
        "repo = \"https://github\\.com/(?<depName>[^\"/]+/[^\"/]+)\"\\s*\\n(?:\\s*#[^\\n]*\\n)*\\s*rev = \"(?<currentDigest>[0-9a-f]{40})\"\\s*# frozen: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "prek installed by j178/prek-action",
      "managerFilePatterns": ["/^\\.github/.+\\.ya?ml$/"],
      "matchStrings": [
        "prek-action@[0-9a-f]{40} # \\S+\\n\\s+env:\\n\\s+SKIP: \\S+\\n\\s+with:\\n\\s+prek-version: (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "j178/prek",
      "datasourceTemplate": "github-releases",
      "depTypeTemplate": "ci-tool",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group non-major GitHub Actions updates, including the digest bumps `helpers:pinGitHubActionDigests` produces.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "GitHub Actions",
      "automerge": true
    },
    {
      "description": "Group non-major Rust crate updates.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "Rust crates",
      "automerge": true
    },
    {
      "description": "Group non-major prek hook and CI tool updates; neither the github-actions nor the cargo rule matches them.",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "CI tools",
      "automerge": true
    },
    {
      "description": "Major updates: one PR per package, reviewed by a human.",
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "automerge": false
    }
  ]
}
