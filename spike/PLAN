# One `key=value` per line; lines starting with # are comments. The workflow reads this on every push.
#
# Everything off except the LTSC ISO check: `legs=` is empty, so no install leg runs. `ltsc_hash=1` runs job `ltsc-hash`,
# a second download of the LTSC 2024 evaluation ISO that records its size, digests and headers (it decides nothing).
#
# To run the LTSC leg once its pin is decided (M1, M5:lean, M9, M14 and E-B; the 25H2 legs stay off):
#   1. set `legs=LTSC` below;
#   2. set `ltsc_sha256=` to the pin (SHA256 of the ISO fwlink 2270353 serves; case does not matter);
#   3. optionally set `ltsc_hash=` empty to skip the check job.
# `reuse_LTSC=` (empty) means a fresh install; `stage_LTSC=` lists the stages that boot after it.
legs=
ltsc_hash=1
# Microsoft's published value (Windows11IoTEnterpriseLTSC2024EvalHashValues.pdf, x64 en-us DVD9). The first download gave
# 2cee70bd183df42b92a2e0da08cc2bb7a2a9ce3a3841955a012c0f77aeb3cb29 (run 43329256748). Undecided: unchanged here.
ltsc_sha256=8abf91c9cd408368dc73aab3425d5e3c02dae74900742072eb5c750fc637c195
reuse=43227036274
reuse_LTSC=
stage=
stage_LTSC=m5:lean,restart:eb
m12b=
cpu=max
disk=available-offline
stacks_from=
